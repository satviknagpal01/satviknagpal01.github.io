---
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, tags = [] } = Astro.props;

const dateStr = pubDate
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(pubDate)
  : null;
---

<BaseLayout title={title} description={description}>
  <article class="article-wrap">
    <header class="article-header">
      {dateStr && <time class="article-date">{dateStr}</time>}
      <h1 class="article-title">{title}</h1>
      {description && <p class="article-desc">{description}</p>}
      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article-wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: calc(var(--nav-h) + var(--s-8)) var(--s-5) var(--s-8);
  }

  .article-header {
    margin-bottom: var(--s-7);
    border-bottom: 2px solid var(--border);
    padding-bottom: var(--s-6);
  }

  .article-date {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--muted);
    margin-bottom: var(--s-3);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 36px);
    color: var(--gold);
    line-height: 1.3;
    margin-bottom: var(--s-4);
  }

  .article-desc {
    font-size: var(--text-body);
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: var(--s-4);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .tag {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 2px 8px;
    background: var(--panel);
  }
</style>
