---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Button from '../components/Button.astro';
import social from '../data/social.json';
import allProjects from '../data/projects.json';

const featured = allProjects
  .filter(p => !p.draft && p.featured)
  .sort((a, b) => a.order - b.order)[0];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge">AVAILABLE FOR HIRE</div>

      <h1 class="hero-title">
        Game Developer<br />
        <span class="hero-title-accent">&amp; Graphics Programmer</span>
      </h1>

      <p class="hero-lead">
        Three years shipping live Unity titles on Android and iOS — specialising in rendering optimisation, runtime systems, and the editor tooling that keeps teams moving. Currently reaching deeper into C++ and GPU architecture.
      </p>

      <div class="hero-actions">
        <Button href="/resume/" variant="ghost">
          Resume ↗
        </Button>
        <Button href={social.github} target="_blank" rel="noopener">
          GitHub
        </Button>
        <Button href={social.linkedin} target="_blank" rel="noopener">
          LinkedIn
        </Button>
        <Button href="/contact/" variant="secondary">
          Contact
        </Button>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <div class="stat-n">2+</div>
          <div class="stat-l">Years XP</div>
        </div>
        <div class="stat-div" aria-hidden="true"></div>
        <div class="stat">
          <div class="stat-n">10+</div>
          <div class="stat-l">Projects</div>
        </div>
        <div class="stat-div" aria-hidden="true"></div>
        <div class="stat">
          <div class="stat-n">2</div>
          <div class="stat-l">Companies</div>
        </div>
      </div>
    </div>
  </section>

  {featured && (
    <section class="featured">
      <div class="section-inner">
        <div class="section-header">
          <h2 class="section-title">// Featured Project</h2>
          <a href="/projects/" class="see-all">See all projects →</a>
        </div>
        <ProjectCard project={featured} featured />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-h) + var(--s-8)) var(--s-5) var(--s-8);
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-5);
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--gold);
    border: 2px solid var(--gold);
    padding: var(--s-2) var(--s-4);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    color: var(--gold);
    line-height: 1.3;
  }

  .hero-title-accent { color: var(--cyan); }

  .hero-lead {
    font-size: var(--text-body);
    color: var(--muted);
    max-width: 56ch;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
  }

  .hero-stats {
    display: flex;
    border: 2px solid var(--border);
    background: var(--panel);
    margin-top: var(--s-4);
  }

  .stat {
    padding: var(--s-4) clamp(var(--s-4), 5vw, var(--s-7));
    text-align: center;
    flex: 1;
    min-width: 0;
  }

  .stat-n {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--gold);
    margin-bottom: var(--s-1);
  }

  .stat-l {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .stat-div {
    width: 2px;
    background: var(--border);
    align-self: stretch;
  }

  .featured {
    padding: var(--s-8) var(--s-5);
  }

  .section-inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-section);
    color: var(--cyan);
    border-bottom: 2px solid var(--border);
    padding-bottom: var(--s-3);
    flex: 1;
  }

  .see-all {
    font-size: var(--text-small);
    color: var(--cyan);
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .see-all:hover,
  .see-all:focus-visible { color: var(--gold); }
</style>
