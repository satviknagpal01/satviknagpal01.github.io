---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import social from '../data/social.json';
---

<BaseLayout
  title="Contact"
  description="Get in touch — email, GitHub, LinkedIn."
>
  <div class="page-wrap">
    <header class="page-header">
      <h1 class="page-title">// Contact</h1>
      <p class="page-desc">Game Developer with production shipping experience — open to roles in engine systems, graphics programming, and high-performance game development.</p>
    </header>

    <div class="contact-grid">
      <div class="contact-main">
        <div class="status-card">
          <div class="status-indicator" aria-hidden="true"></div>
          <div>
            <div class="status-label">Status</div>
            <div class="status-text">Open to opportunities</div>
            <div class="status-sub">Interested in graphics programming, engine systems, and high-performance game development.</div>
          </div>
        </div>

        <div class="contact-cta">
          <p class="cta-text">
            Email is the most direct way to reach me. I take every conversation seriously — whether it's a formal opportunity or a quick question.
          </p>
          <Button href={`mailto:${social.email}`} variant="ghost">
            {social.email}
          </Button>
        </div>
      </div>

      <div class="contact-links">
        <div class="links-card">
          <h2 class="links-title">Links</h2>
          <ul class="links-list">
            <li>
              <a href={social.github} target="_blank" rel="noopener" class="social-link">
                <span class="social-abbr">GH</span>
                <span>GitHub</span>
              </a>
            </li>
            <li>
              <a href={social.linkedin} target="_blank" rel="noopener" class="social-link">
                <span class="social-abbr">LI</span>
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              <a href={`mailto:${social.email}`} class="social-link">
                <span class="social-abbr">@</span>
                <span>Email</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: calc(var(--nav-h) + var(--s-8)) var(--s-5) var(--s-8);
  }

  .page-header {
    margin-bottom: var(--s-7);
    border-bottom: 2px solid var(--border);
    padding-bottom: var(--s-5);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-section);
    color: var(--cyan);
    margin-bottom: var(--s-3);
  }

  .page-desc { color: var(--muted); font-size: var(--text-body); }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--s-5);
    align-items: start;
  }

  @media (max-width: 640px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .contact-main {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .status-card {
    border: 2px solid var(--border);
    background: var(--panel);
    padding: var(--s-5);
    display: flex;
    gap: var(--s-4);
    align-items: flex-start;
  }

  .status-indicator {
    width: 10px;
    height: 10px;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
    flex-shrink: 0;
    margin-top: 4px;
  }

  .status-label {
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--muted);
    margin-bottom: var(--s-2);
    letter-spacing: 0.06em;
  }

  .status-text {
    font-size: var(--text-body);
    color: var(--text);
    margin-bottom: var(--s-2);
  }

  .status-sub {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .contact-cta {
    border: 2px solid var(--border);
    background: var(--panel);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .cta-text {
    font-size: var(--text-body);
    color: var(--muted);
    line-height: 1.6;
  }

  .links-card {
    border: 2px solid var(--border);
    background: var(--panel);
    padding: var(--s-5);
  }

  .links-title {
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--gold);
    letter-spacing: 0.06em;
    margin-bottom: var(--s-5);
  }

  .links-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    font-size: var(--text-body);
    color: var(--text);
    transition: color 150ms ease;
  }
  .social-link:hover,
  .social-link:focus-visible { color: var(--cyan); }

  .social-abbr {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 2px solid var(--border);
    background: var(--bg);
    font-family: var(--font-display);
    font-size: 9px;
    color: var(--cyan);
    flex-shrink: 0;
  }
</style>
