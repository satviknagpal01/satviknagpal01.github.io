---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Tag from '../../components/Tag.astro';
import allProjects from '../../data/projects.json';

export function getStaticPaths() {
  return allProjects
    .filter(p => !p.draft)
    .map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { title, stack, problem, achievements, metrics, repo, liveDemo, body } = project;
---

<ArticleLayout title={title} description={problem}>
  <div class="project-meta">
    <div class="meta-row">
      <span class="meta-label">Stack</span>
      <div class="tags">
        {stack.map((t: string) => <Tag>{t}</Tag>)}
      </div>
    </div>

    {(repo || liveDemo) && (
      <div class="meta-row">
        <span class="meta-label">Links</span>
        <div class="links">
          {repo && <a href={repo} target="_blank" rel="noopener" class="ext-link">GitHub ↗</a>}
          {liveDemo && <a href={liveDemo} target="_blank" rel="noopener" class="ext-link">Live Demo ↗</a>}
        </div>
      </div>
    )}
  </div>

  {achievements.length > 0 && (
    <div class="achievements">
      <h2 class="ach-title">Key Achievements</h2>
      <ul class="ach-list">
        {achievements.map((a: string) => (
          <li><span class="bullet" aria-hidden="true">▶</span>{a}</li>
        ))}
      </ul>
    </div>
  )}

  {metrics && metrics.length > 0 && (
    <div class="metrics">
      <h2 class="ach-title">Performance Metrics</h2>
      <ul class="metrics-list">
        {metrics.map((m: string) => (
          <li><span class="bullet" aria-hidden="true">▸</span>{m}</li>
        ))}
      </ul>
    </div>
  )}

  <Fragment set:html={body} />
</ArticleLayout>

<style>
  .project-meta {
    border: 2px solid var(--border);
    background: var(--panel);
    padding: var(--s-5);
    margin-bottom: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .meta-row {
    display: flex;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .meta-label {
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.06em;
    min-width: 52px;
    padding-top: 3px;
  }

  .tags, .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .ext-link {
    font-size: var(--text-small);
    color: var(--cyan);
    border: 1px solid var(--border);
    padding: 2px 10px;
    transition: border-color 150ms ease;
  }
  .ext-link:hover { border-color: var(--cyan); }

  .achievements, .metrics {
    border: 2px solid var(--border);
    background: var(--panel);
    padding: var(--s-5);
    margin-bottom: var(--s-6);
  }

  .ach-title {
    font-family: var(--font-display);
    font-size: 11px;
    color: var(--cyan);
    letter-spacing: 0.06em;
    margin-bottom: var(--s-4);
  }

  .ach-list, .metrics-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .ach-list li, .metrics-list li {
    display: flex;
    gap: var(--s-3);
    font-size: var(--text-small);
    color: var(--text);
    line-height: 1.6;
  }

  .bullet { color: var(--gold); font-size: 9px; padding-top: 4px; flex-shrink: 0; }
</style>
