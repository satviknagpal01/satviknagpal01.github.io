---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import experience from '../data/experience.json';
---

<BaseLayout
  title="Experience"
  description="Professional experience in game development, graphics programming, and engine systems."
>
  <div class="page-wrap">
    <header class="page-header">
      <h1 class="page-title">// Experience</h1>
      <p class="page-desc">
        Three years of production game development — shipping live titles, building runtime tools, and optimising for real hardware constraints.
      </p>
    </header>

    <div class="exp-list">
      {experience.map(exp => (
        <ExperienceItem
          company={exp.company}
          role={exp.role}
          location={exp.location}
          start={exp.start}
          end={exp.end}
          bullets={exp.bullets}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: calc(var(--nav-h) + var(--s-8)) var(--s-5) var(--s-8);
  }

  .page-header {
    margin-bottom: var(--s-7);
    border-bottom: 2px solid var(--border);
    padding-bottom: var(--s-5);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-section);
    color: var(--cyan);
    margin-bottom: var(--s-3);
  }

  .page-desc { color: var(--muted); font-size: var(--text-body); }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
</style>
