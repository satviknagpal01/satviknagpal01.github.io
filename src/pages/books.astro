---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/library.css';
import { getCollection } from 'astro:content';

const books = (await getCollection('books'))
  .map(e => e.data)
  .sort((a, b) =>
    (b.dateAdded ?? '').localeCompare(a.dateAdded ?? '') ||
    a.title.localeCompare(b.title)
  );

const initials = (t: string) =>
  t.split(' ').slice(0, 2).map(w => w[0] ?? '').join('').toUpperCase() || '??';
---

<BaseLayout
  title="Books"
  description="A personal log of books I own — searchable by title, author, and status."
>
  <div class="page-wrap">
    <header class="page-header">
      <h1 class="page-title">// Books</h1>
      <p class="page-desc">
        Every book I own — a running log of {books.length}.
        <a class="page-xlink" href="/wishlist/">Wishlist →</a>
      </p>
    </header>

    <div class="controls">
      <input
        type="search"
        id="search"
        class="ctrl-input ctrl-search"
        placeholder="Search title or author…"
        aria-label="Search books"
        autocomplete="off"
      />
      <select id="status-filter" class="ctrl-input ctrl-select" aria-label="Filter by status">
        <option value="">All statuses</option>
        <option value="Read">Read</option>
        <option value="Reading">Reading</option>
        <option value="Unread">Unread</option>
        <option value="Wishlist">Wishlist</option>
      </select>
    </div>

    <p id="result-count" class="result-count" aria-live="polite" aria-atomic="true"></p>

    {books.length === 0 ? (
      <div class="state-box">
        <p class="state-text">No books yet — add some in the Keystatic admin.</p>
      </div>
    ) : (
      <div class="book-grid" id="book-grid">
        {books.map(b => (
          <article
            class="book-card"
            data-title={b.title.toLowerCase()}
            data-author={b.author.toLowerCase()}
            data-status={b.status}
          >
            <div class="book-thumb" aria-hidden="true">
              {b.coverURL && (
                <img class="book-cover-img" src={b.coverURL} alt={b.title} loading="lazy" />
              )}
              <span class="book-initials" style={b.coverURL ? 'display:none' : ''}>
                {initials(b.title)}
              </span>
            </div>
            <div class="book-body">
              <span class={`book-badge book-badge--${b.status.toLowerCase()}`}>{b.status}</span>
              <h3 class="book-title">{b.title}</h3>
              {b.author && <p class="book-author">{b.author}</p>}
              {b.genres.length > 0 && (
                <div class="book-chips">
                  {b.genres.slice(0, 5).map(g => <span class="book-chip">{g}</span>)}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <div id="state-no-match" class="state-box" hidden>
      <p class="state-text">No books match — try adjusting search or status.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const search    = document.getElementById('search') as HTMLInputElement | null;
  const statusSel = document.getElementById('status-filter') as HTMLSelectElement | null;
  const count     = document.getElementById('result-count');
  const noMatch   = document.getElementById('state-no-match');
  const cards     = Array.from(document.querySelectorAll<HTMLElement>('.book-card'));

  function apply() {
    const q  = (search?.value ?? '').trim().toLowerCase();
    const st = statusSel?.value ?? '';
    let shown = 0;
    for (const card of cards) {
      const okText   = !q || (card.dataset.title ?? '').includes(q) || (card.dataset.author ?? '').includes(q);
      const okStatus = !st || card.dataset.status === st;
      const show = okText && okStatus;
      card.style.display = show ? '' : 'none';
      if (show) shown++;
    }
    if (count) count.textContent = `${shown} book${shown !== 1 ? 's' : ''}`;
    if (noMatch) noMatch.hidden = shown !== 0 || cards.length === 0;
  }

  search?.addEventListener('input', apply);
  statusSel?.addEventListener('change', apply);
  apply();

  // Broken cover URL → fall back to the initials tile.
  for (const img of document.querySelectorAll<HTMLImageElement>('.book-cover-img')) {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      const init = img.parentElement?.querySelector<HTMLElement>('.book-initials');
      if (init) init.style.display = '';
    });
  }
</script>
