---
import skills from '../data/skills.json';

const categories = [
  { key: 'languages',    label: 'Languages',      color: 'gold' },
  { key: 'graphicsAPIs', label: 'Graphics APIs',  color: 'cyan' },
  { key: 'engines',      label: 'Engines',         color: 'gold' },
  { key: 'tools',        label: 'Tools',           color: 'cyan' },
  { key: 'profilers',    label: 'Profilers',       color: 'gold' },
] as const;

type SkillKey = keyof typeof skills;
---

<div class="skills-grid">
  {categories.map(cat => (
    <div class="skill-cat">
      <h4 class:list={['skill-cat-title', `skill-cat-title--${cat.color}`]}>
        {cat.label}
      </h4>
      <ul class="skill-list">
        {(skills[cat.key as SkillKey] as string[]).map(item => (
          <li class="skill-item">
            <span class="skill-bullet" aria-hidden="true">▶</span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s-4);
  }

  .skill-cat {
    border: 2px solid var(--border);
    background: var(--panel);
    padding: var(--s-4) var(--s-5);
  }

  .skill-cat-title {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.08em;
    margin-bottom: var(--s-4);
  }
  .skill-cat-title--gold { color: var(--gold); }
  .skill-cat-title--cyan { color: var(--cyan); }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .skill-item {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
    font-size: var(--text-small);
    color: var(--text);
    line-height: 1.5;
  }

  .skill-bullet {
    color: var(--cyan);
    font-size: 8px;
    padding-top: 4px;
    flex-shrink: 0;
  }
</style>
